#include <windows.h>
#include <winver.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "app.ico"
IDI_CLAUDE ICON "claude.ico"
IDI_CODEX ICON "codex.ico"
IDI_GEMINI ICON "gemini.ico"
1 24 "app.manifest"

// Section rules, the provider card and the reset-time group are painted by
// PaintSettings in main.cpp; keep its coordinates in sync with this layout.
IDD_SETTINGS DIALOGEX 0, 0, 278, 438
STYLE DS_SETFONT | WS_POPUP | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "AI Usage Monitor settings"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "AI Usage Monitor - Settings", IDC_SETTINGS_TITLE, 14, 6, 222, 15, SS_CENTERIMAGE
  CONTROL "Close", IDCANCEL, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 245, 5, 23, 17

  LTEXT "Providers", IDC_PROVIDERS_TITLE, 14, 31, 248, 11
  LTEXT "Choose which AI providers to monitor.", IDC_SETTINGS_HINT, 14, 42, 248, 10
  CONTROL "Claude", ID_USAGE_FIRST, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 54, 250, 18
  CONTROL "Codex", ID_USAGE_FIRST+1, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 72, 250, 18
  CONTROL "Gemini", ID_USAGE_FIRST+2, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 90, 250, 18

  LTEXT "Display", IDC_DISPLAY_TITLE, 14, 120, 248, 11
  LTEXT "How the usage is shown in the taskbar.", IDC_SETTINGS_HINT, 14, 131, 248, 10
  LTEXT "&Location", IDC_SETTINGS_LABEL, 14, 143, 117, 10
  COMBOBOX IDC_LOCATION, 14, 153, 117, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "&Taskbar display", IDC_SETTINGS_LABEL, 146, 143, 118, 10
  COMBOBOX ID_DISPLAY, 146, 153, 118, 62, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  CONTROL "Show taskbar widget background", ID_WIDGET_BACKGROUND, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 172, 250, 14
  CONTROL "Show tooltip on hover", ID_HOVER_TOOLTIP, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 188, 250, 14

  LTEXT "Reset time", IDC_RESET_TITLE, 14, 212, 248, 11
  LTEXT "How to show when each limit resets.", IDC_SETTINGS_HINT, 14, 223, 248, 10
  CONTROL "Relative", ID_RESET, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 236, 83, 26
  CONTROL "Absolute", ID_RESET+1, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 97, 236, 84, 26
  CONTROL "Both", ID_RESET+2, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 181, 236, 83, 26

  LTEXT "Warnings", IDC_WARNINGS_TITLE, 14, 274, 248, 11
  LTEXT "Highlight high usage and optionally show Windows notifications.", IDC_SETTINGS_HINT, 14, 285, 248, 10
  CONTROL "Use warning colors (based on usage)", ID_COLORS, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 298, 250, 14
  LTEXT "&Warning threshold", IDC_SETTINGS_LABEL, 23, 315, 108, 10
  COMBOBOX ID_WARNING, 14, 325, 117, 76, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "C&ritical threshold", IDC_SETTINGS_LABEL, 155, 315, 109, 10
  COMBOBOX ID_CRITICAL, 146, 325, 118, 76, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  CONTROL "Show Windows notifications on threshold crossings", ID_NOTIFICATIONS, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 344, 250, 14

  CONTROL "Start with Windows", ID_AUTOSTART, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 368, 108, 15
  CONTROL "Automatic update checks", ID_AUTO_UPDATE, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 126, 368, 140, 15
  CONTROL "Copy Claude live update settings", ID_CLAUDE_LIVE_SETTINGS, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 386, 130, 12
  CONTROL "Open Claude setup", ID_CLAUDE_SETUP, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 146, 386, 118, 12

  CONTROL "Check for program updates", ID_APP_UPDATE, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 408, 126, 12
  CONTROL "Exit monitor", ID_EXIT, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 14, 421, 126, 12
  CONTROL "Refresh now", ID_REFRESH, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 146, 410, 64, 20
  CONTROL "Done", IDOK, "BUTTON", BS_OWNERDRAW | BS_NOTIFY | WS_TABSTOP, 214, 410, 50, 20
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION AUM_VERSION_NUMBERS
PRODUCTVERSION AUM_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "AI Usage Monitor"
      VALUE "ProductName", "AI Usage Monitor"
      VALUE "FileVersion", AUM_VERSION_STRING
      VALUE "ProductVersion", AUM_VERSION_STRING
      VALUE "OriginalFilename", "AIUsageMonitor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
