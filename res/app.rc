#include <winver.h>
#include "resource.h"

IDI_APP ICON "app.ico"
IDI_CLAUDE ICON "claude.ico"
IDI_CODEX ICON "codex.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "AI Usage Monitor"
      VALUE "ProductName", "AI Usage Monitor"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "AIUsageMonitor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
